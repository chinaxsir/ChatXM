{
  "expo": {
    "name": "ChatXM",
    "slug": "ChatXM",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chatxm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.xsircn.chatxm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "需要使用相机拍照发送图片",
        "NSPhotoLibraryUsageDescription": "需要访问相册选择图片",
        "NSMicrophoneUsageDescription": "需要使用麦克风进行语音输入",
        "NSSpeechRecognitionUsageDescription": "需要使用语音识别将语音转为文字"
      }
    },
    "android": {
      "package": "com.xsircn.chatxm",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2008097e-caa9-4e3c-a15e-a9ce0ee58635"
      }
    },
    "owner": "xsircn"
  }
}
